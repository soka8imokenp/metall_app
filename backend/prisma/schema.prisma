/// Заявка на сброс пароля: система пароль не рассылает, администратор выдаёт.
model PasswordResetRequest {
  id          BigInt    @id @default(autoincrement())
  uid         String    @unique @default(uuid(7)) @db.Uuid
  login       String
  contact     String
  note        String?
  userId      BigInt?   @map("user_id")
  status      String    @default("new")
  handledBy   BigInt?   @map("handled_by")
  handledAt   DateTime? @map("handled_at") @db.Timestamptz(6)
  handledNote String?   @map("handled_note")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user    UserAccount? @relation("ResetRequestUser", fields: [userId], references: [id])
  handler UserAccount? @relation("ResetRequestHandler", fields: [handledBy], references: [id])

  @@index([status, createdAt])
  @@map("password_reset_request")
}

/// Журнал резервных копий базы: когда, сколько шла, сколько весит, чем кончилась.
///
/// Строка заводится до запуска `pg_dump` и закрывается после: упавший процесс
/// иначе не оставил бы следа, а «копия не делалась» и «копия упала» — разные
/// новости. RLS нет: копия — вся база целиком, делить её по компаниям нечего.
model DbBackup {
  id          BigInt    @id @default(autoincrement())
  uid         String    @unique @default(uuid(7)) @db.Uuid
  /// running → ok | failed.
  status      String    @default("running")
  /// `schedule` — по расписанию, `manual` — кнопкой.
  source      String    @default("schedule")
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs  Int?      @map("duration_ms")
  fileName    String    @map("file_name")
  sizeBytes   BigInt?   @map("size_bytes")
  sha256      String?
  error       String?
  startedBy   BigInt?   @map("started_by")

  starter UserAccount? @relation("DbBackupStarter", fields: [startedBy], references: [id], onDelete: SetNull)

  @@index([startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@map("db_backup")
}
