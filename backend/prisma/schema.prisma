/// Вложение к операции: фото, скан, сертификат качества партии (ТЗ 5.4, 5.6, 6.3).
/// Байты лежат на диске по `storageKey`, в базе только описание. Владелец —
/// ровно одна из трёх ссылок, это держит ограничение `attachment_one_owner`.
model Attachment {
  id                 BigInt         @id @default(autoincrement())
  uid                String         @unique @default(uuid(7)) @db.Uuid
  companyId          BigInt         @map("company_id")
  stockMoveId        BigInt?        @map("stock_move_id")
  batchId            BigInt?        @map("batch_id")
  financeOperationId BigInt?        @map("finance_operation_id")
  productionOrderId  BigInt?        @map("production_order_id")
  productionStageId  BigInt?        @map("production_stage_id")
  documentId         BigInt?        @map("document_id")
  partnerId          BigInt?        @map("partner_id")
  kind               AttachmentKind @default(other)
  fileName           String         @map("file_name")
  mimeType           String         @map("mime_type")
  sizeBytes          Int            @map("size_bytes")
  sha256             String         @db.Char(64)
  storageKey         String         @unique @map("storage_key")
  comment            String?
  createdBy          BigInt?        @map("created_by")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  company          Company           @relation(fields: [companyId], references: [id])
  stockMove        StockMove?        @relation(fields: [stockMoveId], references: [id], onDelete: Cascade)
  batch            Batch?            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  financeOperation FinanceOperation? @relation(fields: [financeOperationId], references: [id], onDelete: Cascade)
  productionOrder  ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionStage  ProductionStage?  @relation(fields: [productionStageId], references: [id], onDelete: Cascade)
  document         Document?         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  partner          Partner?          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([stockMoveId])
  @@index([batchId])
  @@index([financeOperationId])
  @@index([productionOrderId])
  @@index([productionStageId], map: "attachment_production_stage_idx")
  @@index([documentId])
  @@index([partnerId], map: "attachment_partner_idx")
  @@map("attachment")
}

