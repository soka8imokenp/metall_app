{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://metall-asia.cloudplus.uz/api/v1"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "resourceClass": "default"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://metall-asia.cloudplus.uz/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
